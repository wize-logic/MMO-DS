<?xml version="1.0" encoding="utf-8"?>
<!--
  The Java side of this app is one class of four small jobs: OpenMMOActivity
  extends NativeActivity to hear the document picker's answer (which the
  framework delivers to onActivityResult and NativeActivity swallows), to
  hide the system bars, to hand a downloaded update to the package
  installer and hear its verdict, and to give the system keyboard the
  InputConnection it types into, which no C entry point can supply.
  Everything else still arrives in C (the surface, the input queue, the
  lifecycle) because NativeActivity still loads the library named below and
  calls ANativeActivity_onCreate in it.

  targetSdkVersion is 35, set in Makefile.android where the reasoning is
  written out. It was 28, held one level below scoped storage while the
  cartridge still needed a file path, and the day the picker landed
  (ddc6229e) that reason expired without anybody moving the number. What it
  cost in the meantime was the installer calling this app unsafe, because
  Play Protect warns about any app targeting more than two API levels below
  the device's own.

  NOTE FOR ANYONE EDITING THESE COMMENTS: a double hyphen cannot appear
  inside an XML comment. aapt2 rejects the manifest with "not well-formed
  (invalid token)" and names only the line the comment STARTS on.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="org.openmmo.handheld"
          android:versionCode="1"
          android:versionName="0.1">

  <uses-feature android:glEsVersion="0x00020000" android:required="true" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <uses-feature android:name="android.hardware.gamepad" android:required="false" />

  <uses-permission android:name="android.permission.INTERNET" />

  <!--
    THE UPDATE BUTTON. The front door fetches the new APK out of the signed
    channel itself and asks the package installer to put it in place; this is
    the row that lets an app ask that. It is not a runtime prompt: Android
    opens a per-app settings switch the first time, the player flips it once,
    and every update after is the installer's own confirmation dialog and
    nothing else. Without this row canRequestPackageInstalls is false forever
    and the switch is not even offered.
  -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

  <!--
    NO STORAGE PERMISSION AT ALL, and that is the point of the one Java class
    this app carries. The cartridge is the player's file, chosen through the
    system document picker, whose grant is per-file and needs no permission
    row and no trip to Settings. The drawn fallback browser inside the front
    door still exists for a device whose picker is broken, and on a stock
    device it is the one path that may fail to read; it says so and points
    back at the picker.

    READ_EXTERNAL_STORAGE stays for Android 10 and older only, where the
    fallback browser is more likely to be needed and this is the row that
    feeds it.
  -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
                   android:maxSdkVersion="29" />

  <!--
    extractNativeLibs="false" is the platform's own default from API 30 and is
    written out because the packaging has to agree with it: Makefile.android
    stores the library uncompressed and aligns it to 16 KB so the loader can
    map it out of the package instead of unpacking a second copy. The two
    belong together, and a reader who changes one needs to see the other.
  -->
  <application android:label="OpenMMO"
               android:icon="@mipmap/ic_launcher"
               android:roundIcon="@mipmap/ic_launcher"
               android:extractNativeLibs="false"
               android:allowBackup="false">
    <!-- THIS IS A LANDSCAPE GAME AND NOW IT SAYS SO. Every layout in the app
         is built for a wide surface: the viewer's two DS screens side by
         side, the on-screen pad's thumbs at the outer corners, the front
         door's panels. It was never declared because the RG556 could not
         produce anything else (a measurement there showed that even an APK asking
         for portrait got 1920x1080), so the portrait path has never once
         been drawn, and the one time a portrait surface was measured at all
         (720x1280) it hung the button row off the bottom edge.
         Relying on a device's inability to rotate is not a layout decision,
         so the orientation is asked for here. sensorLandscape rather than
         landscape: a player may hold the device either way up.

         showWhenLocked + turnScreenOn: a handheld's power button is how a
         player pauses, and coming back must not strand the game behind a
         swipe keyguard with its window revoked. The idle doze also swallowed
         every adb-driven session before these two.

         No windowSoftInputMode here, on purpose: NativeActivity.onCreate
         sets the window's mode itself, over the manifest, so the one that
         holds is set in OpenMMOActivity.onCreate after super. -->
    <activity android:name="org.openmmo.handheld.OpenMMOActivity"
              android:label="OpenMMO"
              android:launchMode="singleTask"
              android:exported="true"
              android:screenOrientation="sensorLandscape"
              android:showWhenLocked="true"
              android:turnScreenOn="true"
              android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode">
      <!-- The .so this loads: lib/<abi>/libpokeplatinum.so (armeabi-v7a on a device, x86 on the emulator), which is
           the engine, this client and the code beside this file, fused. -->
      <meta-data android:name="android.app.lib_name" android:value="pokeplatinum" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
