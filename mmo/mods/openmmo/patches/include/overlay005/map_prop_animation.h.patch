--- a/include/overlay005/map_prop_animation.h
+++ b/include/overlay005/map_prop_animation.h
@@ -7,7 +7,14 @@
 
 #define MAP_PROP_ANIME_LIST_FILE_ARCHIVE_IDS_COUNT 4
 
-#define MAP_PROP_ANIMATION_MANAGER_MAX_ANIMATIONS               16
+/* Raised from 16 for a ported region. This game loads every ambient
+ * animation of an AREA's whole build list into these slots at area entry,
+ * and a HeartGold area spans a town and its roads at once: 31 slots even
+ * deduped, measured on 2026-08-31. The manager is one struct inside the
+ * field's heap, so the raise costs 48 * sizeof(MapPropAnimation) = 1920
+ * bytes; the loader skips a row past the slots rather than asserting
+ * (src/overlay005/map_prop_animation.c). */
+#define MAP_PROP_ANIMATION_MANAGER_MAX_ANIMATIONS               64
 #define MAP_PROP_ANIMATION_MANAGER_MAX_BICYCLE_SLOPE_ANIMATIONS 2
 
 #define MAP_PROP_ONE_SHOT_ANIMATION_MAX_ANIMATIONS 4
@@ -16,6 +23,14 @@
 
 #define MAP_PROP_ONE_SHOT_ANIMATION_MANAGER_MAX_ITEMS 16
 
+/* openmmo: how many placed props one animation slot may drive at once. An
+ * animation object sits in ONE render object's list, its own `next` is the
+ * link, and a HeartGold area places the same sign or flower many times,
+ * so every placement gets a clone of the slot's object, advanced with the
+ * slot, and gives it back when its chunk unloads
+ * (src/overlay005/map_prop_animation.c, map_prop.c). */
+#define MAP_PROP_ANIMATION_CLONES 48
+
 typedef struct MapPropAnimation {
     NNSG3dAnmObj *animationObj;
     BOOL loaded;
@@ -27,6 +42,12 @@
     BOOL looping;
     BOOL reversed;
     int pastoriaGymButtonGroup;
+    /* openmmo: the texture set the slot was bound against, and the clones
+     * with the render object each one sits in. */
+    NNSG3dResTex *texture;
+    NNSG3dAnmObj *clones[MAP_PROP_ANIMATION_CLONES];
+    NNSG3dRenderObj *cloneOwner[MAP_PROP_ANIMATION_CLONES];
+    int cloneCount;
 } MapPropAnimation;
 
