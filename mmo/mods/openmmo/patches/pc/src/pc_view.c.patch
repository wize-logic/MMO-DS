+static int view_hd_dynamic(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *e = getenv("PC_HD3D_DYNAMIC");
+
+        on = (e == NULL) ? 1 : (e[0] != '0');
+    }
+    return on;
+}
