+int pc_modfs_billboard(int gfx_id, struct pc_modfs_billboard *out)
+{
+    const struct gfx_claim *row = find_gfx(gfx_id);
+
+    if (row == NULL) {
+        return 0;
+    }
+    if (out != NULL) {
+        out->nsbtx = row->nsbtx;
+        out->model = row->model;
+        out->seq = row->seq;
+        out->like = row->like;
+    }
+    return 1;
+}
+
+int pc_modfs_billboard_seq(int seq_id, struct pc_modfs_billboard_seq *out)
+{
+    int i;
+
+    for (i = 0; i < sNSeqs; i++) {
+        if (sSeqs[i].seq == seq_id) {
+            if (out != NULL) {
+                out->member = sSeqs[i].member;
+                out->facings = sSeqs[i].facings;
+                out->frames = sSeqs[i].frames;
+            }
+            return 1;
+        }
+    }
+    return 0;
+}
