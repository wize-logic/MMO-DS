+static int order_cmp(const void *a, const void *b)
+{
+    const struct mclaim *x = &sMembers[*(const int *)a];
+    const struct mclaim *y = &sMembers[*(const int *)b];
+    int c = strcmp(x->nitro, y->nitro);
+
+    if (c != 0) {
+        return c;
+    }
+    if (x->index != y->index) {
+        return x->index < y->index ? -1 : 1;
+    }
+    return 0;
+}
+
+static void member_index_build(void)
+{
+    int i;
+
+    if (sOrderMembers == sNMembers) {
+        return;
+    }
+    free(sOrder);
+    sOrder = NULL;
+    sOrderMembers = sNMembers;
+    if (sNMembers <= 0) {
+        return;
+    }
+    sOrder = malloc((size_t)sNMembers * sizeof *sOrder);
+    if (sOrder == NULL) {
+        die("out of memory");
+    }
+    for (i = 0; i < sNMembers; i++) {
+        sOrder[i] = i;
+    }
+    qsort(sOrder, (size_t)sNMembers, sizeof *sOrder, order_cmp);
