+static int member_index_lower(const char *key, unsigned index)
+{
+    int lo = 0;
+    int hi = sNMembers;
+
+    member_index_build();
+    while (lo < hi) {
+        int mid = lo + (hi - lo) / 2;
+        const struct mclaim *m = &sMembers[sOrder[mid]];
+        int c = strcmp(m->nitro, key);
