+static void load_billboard_seq(const struct pkg *pk)
+{
+    char path[PC_MODFS_PATH];
+    FILE *f;
+    char line[128];
+
+    join_path(path, sizeof path, pk->path,
+              ".cooked/generated/billboard_seq.txt");
+    if (!is_file(path)) {
+        return;
+    }
+    f = fopen(path, "r");
+    if (f == NULL) {
+        die("cannot read %s", path);
+    }
+    while (fgets(line, sizeof line, f) != NULL) {
+        char *hash = strchr(line, '#');
+        int seq, member, facings, frames;
+        int i;
+
+        if (hash != NULL) {
+            *hash = '\0';
+        }
+        if (sscanf(line, "%d %d %d %d", &seq, &member, &facings, &frames)
+            != 4) {
+            continue;
+        }
+        if (seq < 0 || member < 0 || member >= 65535 || facings < 1
+            || frames < 1) {
+            fclose(f);
+            die("bad billboard sequence row in %s: %d %d %d %d",
+                pk->dir, seq, member, facings, frames);
+        }
+        for (i = 0; i < sNSeqs; i++) {
+            if (sSeqs[i].seq == seq) {
+                break;
+            }
+        }
+        if (i == sNSeqs) {
+            if (sNSeqs >= PC_MODFS_MAX_SEQS) {
+                fclose(f);
+                die("too many cooked billboard sequences (max %d)",
+                    PC_MODFS_MAX_SEQS);
+            }
+            sNSeqs++;
+        }
+        sSeqs[i].seq = seq;
+        sSeqs[i].member = member;
+        sSeqs[i].facings = facings;
+        sSeqs[i].frames = frames;
+    }
+    fclose(f);
+}
+
+static int gfx_claim_cmp(const void *a, const void *b)
+{
+    const struct gfx_claim *x = a;
+    const struct gfx_claim *y = b;
+
+    return (x->gfx > y->gfx) - (x->gfx < y->gfx);
+}
+
+/* Sorted once, after every package has had its say, so a later package
+ * overriding an earlier one's row still happens in load order. */
+static void sort_gfx(void)
+{
+    if (sNGfx > 1) {
+        qsort(sGfx, (size_t)sNGfx, sizeof sGfx[0], gfx_claim_cmp);
+    }
+}
+
+static const struct gfx_claim *find_gfx(int gfx_id)
+{
+    int lo = 0;
+    int hi = sNGfx - 1;
+
+    while (lo <= hi) {
+        int mid = lo + (hi - lo) / 2;
+
+        if (sGfx[mid].gfx == gfx_id) {
+            return &sGfx[mid];
+        }
+        if (sGfx[mid].gfx < gfx_id) {
+            lo = mid + 1;
+        } else {
+            hi = mid - 1;
+        }
+    }
+    return NULL;
+}
