+static void load_billboard_seq(const struct pkg *pk)
+{
+    char path[PC_MODFS_PATH];
+    FILE *f;
+    char line[128];
+
+    join_path(path, sizeof path, pk->path,
+              ".cooked/generated/billboard_seq.txt");
+    if (!is_file(path)) {
+        return;
+    }
+    f = fopen(path, "r");
+    if (f == NULL) {
+        die("cannot read %s", path);
+    }
+    while (fgets(line, sizeof line, f) != NULL) {
+        char *hash = strchr(line, '#');
+        int seq, member, facings, frames;
+        int i;
+
+        if (hash != NULL) {
+            *hash = '\0';
+        }
+        if (sscanf(line, "%d %d %d %d", &seq, &member, &facings, &frames)
+            != 4) {
+            continue;
+        }
+        if (seq < 0 || member < 0 || member >= 65535 || facings < 1
+            || frames < 1) {
+            fclose(f);
+            die("bad billboard sequence row in %s: %d %d %d %d",
+                pk->dir, seq, member, facings, frames);
+        }
+        for (i = 0; i < sNSeqs; i++) {
+            if (sSeqs[i].seq == seq) {
+                break;
+            }
+        }
+        if (i == sNSeqs) {
+            if (sNSeqs >= PC_MODFS_MAX_SEQS) {
+                fclose(f);
+                die("too many cooked billboard sequences (max %d)",
+                    PC_MODFS_MAX_SEQS);
+            }
+            sNSeqs++;
+        }
+        sSeqs[i].seq = seq;
+        sSeqs[i].member = member;
+        sSeqs[i].facings = facings;
+        sSeqs[i].frames = frames;
+    }
+    fclose(f);
+}
