+static int gfx_claim_cmp(const void *a, const void *b)
+{
+    const struct gfx_claim *x = a;
+    const struct gfx_claim *y = b;
+
+    return (x->gfx > y->gfx) - (x->gfx < y->gfx);
+}
+
+/* Sorted once, after every package has had its say, so a later package
+ * overriding an earlier one's row still happens in load order. */
+static void sort_gfx(void)
+{
+    if (sNGfx > 1) {
+        qsort(sGfx, (size_t)sNGfx, sizeof sGfx[0], gfx_claim_cmp);
+    }
+}
+
+static const struct gfx_claim *find_gfx(int gfx_id)
+{
+    int lo = 0;
+    int hi = sNGfx - 1;
+
+    while (lo <= hi) {
+        int mid = lo + (hi - lo) / 2;
+
+        if (sGfx[mid].gfx == gfx_id) {
+            return &sGfx[mid];
+        }
+        if (sGfx[mid].gfx < gfx_id) {
+            lo = mid + 1;
+        } else {
+            hi = mid - 1;
+        }
+    }
+    return NULL;
+}
