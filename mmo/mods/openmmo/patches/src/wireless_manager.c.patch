  */
 u16 WirelessManager_GetConnectedBitmap(void)
 {
+    /* openmmo: no radio here; see WirelessManager_SetDisconnectCallback. */
+    if (sWirelessManager == NULL) {
+        return 0;
+    }
+
     return sWirelessManager->connectedBitmap;
 }
 
@@ -1711,6 +1716,16 @@
  */
 void WirelessManager_SetDisconnectCallback(WirelessManagerConnectFunc callback)
 {
+    /* openmmo: there is no DS radio in this port, so this manager is never
+     * allocated, and the Underground registers a disconnect callback on its
+     * way up whether one exists or not (underground/manager.c,
+     * UndergroundMan_Init), which is a write through NULL. A link that cannot
+     * drop has nothing to call back, so the registration is simply dropped.
+     * The engine's own guard everywhere else in this file is the same test. */
+    if (sWirelessManager == NULL) {
+        return;
+    }
+
     sWirelessManager->disconnectCallback = callback;
 }
 
