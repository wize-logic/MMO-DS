+    SoundSystem_LoadSequenceEx(*currentBGM, NNS_SND_ARC_LOAD_WAVE | NNS_SND_ARC_LOAD_BANK);
+
+    /* Only reachable on a bank the official client never has: with the two Sinnoh banks the
+     * sequence being resumed shares the wave archives just loaded. A composed
+     * soundtrack track owns its bank outright, so that comes along too. */
+    if (bgmID != *currentBGM && currentBankID != BANK_BGM_FIELD_sbnk && currentBankID != BANK_BGM_DUNGEON_sbnk) {
+        SoundSystem_LoadSequenceEx(bgmID, NNS_SND_ARC_LOAD_WAVE | NNS_SND_ARC_LOAD_BANK);
     }
 
