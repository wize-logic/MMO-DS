+/* openmmo: the same door Encounter_NewVsLink is, for a link battle the server
+ * opened rather than the party-order menu. NewEncounter and FieldTask_LinkEncounter
+ * are both static, and a duel has no FieldTask to call into, so the two lines are
+ * here rather than in mods/openmmo/src/openmmo_link.c. */
+void openmmo_encounter_new_vs_link(FieldSystem *fieldSystem, FieldBattleDTO *dto)
+{
+    /* openmmo: a duel opens with the ordinary trainer cut-in and the ordinary
+     * trainer theme, which is what it opened with when both sides' class was
+     * a gender. Both are chosen from dto->trainer[1]'s CLASS, and that class
+     * is the body the player on net id 1 picked now
+     * (mods/openmmo/src/openmmo_link.c), so asking for them straight would
+     * open a duel against somebody wearing Volkner with Volkner's cut-in and
+     * Volkner's music, and open it differently on the two screens, because
+     * net id 1 is the opponent on one of them and yourself on the other. The
+     * class is put back before the encounter is built, so the sprite the
+     * scene draws is still the picked body's. */
+    u8 keptClass = dto->trainer[1].header.trainerType;
+    u32 cutIn, bgm;
+    Encounter *encounter;
+
+    dto->trainer[1].header.trainerType = TRAINER_CLASS_PLAYER_MALE;
+    cutIn = EncEffects_CutInEffect(dto);
+    bgm = EncEffects_BGM(dto);
+    dto->trainer[1].header.trainerType = keptClass;
+
+    encounter = NewEncounter(dto, cutIn, bgm, NULL);
+    FieldSystem_CreateTask(fieldSystem, FieldTask_LinkEncounter, encounter);
+}
