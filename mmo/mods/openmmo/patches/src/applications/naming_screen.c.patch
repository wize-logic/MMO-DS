+
+/* The first tile column of the entry row.
+ *
+ * The official client's is always 10, which leaves 22 of the screen's 32 columns for the
+ * cells, fourteen of them at the 12-pixel pitch the row is drawn and the
+ * cursor sprites are placed at. Every caller in the cartridge asks for ten
+ * glyphs or fewer, so the ten columns to the left of the row are free for the
+ * icon and nothing ever met the ceiling.
+ *
+ * A chat line is the first caller that wants more than the row can hold, so
+ * the row slides left by exactly as much as it overruns and stops at the edge.
+ * A screen asking for twelve glyphs or fewer computes 10 and is what it always
+ * was; past that the icon's ten columns are what the extra cells are made of,
+ * which is why NamingScreen_InitIconSprite stops drawing one.
+ *
+ * The hard ceiling is not here, it is nameInputRaw[20] in the args struct
+ * every caller allocates, so at most nineteen glyphs and a terminator. */
+static int NamingScreen_EntryColumn(int maxChars)
+{
+    int width = ((maxChars * 12) / 8) + 1;
+    int x = 32 - width;
+
+    if (x > 10) {
+        x = 10;
+    }
+
+    return x < 0 ? 0 : x;
+}
