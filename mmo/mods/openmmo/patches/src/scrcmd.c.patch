 static BOOL ScrCmd_131(ScriptContext *ctx)
 {
+    /* openmmo: the device may already be on, and then this must not run.
+     *
+     * The official client's "the Poketch switches on" task is written for the one state its
+     * script can be in: the lower screen is the unavailable placeholder. So it
+     * leaves that screen, PoketchUnavailableScreen_Exit, which is
+     * Heap_Destroy(HEAP_ID_POKETCH_APP), unloads that overlay and builds a
+     * PoketchSystem in its place. Run it with a PoketchSystem already live and
+     * it destroys the heap that system is holding and then creates a second
+     * system over the first, which is the crash a player meets when the
+     * Poketch Co president finally hands the watch over.
+     *
+     * A running device means there is nothing to switch on, so the command is
+     * the no-op it means. The RegisterPoketchApp calls either side of it in the
+     * script are untouched and still land. */
+    if (FieldSystem_GetPoketchSystem() != NULL) {
+        return FALSE;
+    }
+
     ov5_021DDBC8(ctx->task);
     return TRUE;
 }
