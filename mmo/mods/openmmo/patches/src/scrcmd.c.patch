+/* openmmo: the Contest Hall's link door.
+ *
+ * The official client's two commands here open the DS communication club, "join a group"
+ * or "become the leader", and wait for a wireless group to form. This client's
+ * group is its server and its queue, so for a contest both commands mean the
+ * same thing: ask to be put in one, and wait for a seat. Everything either side
+ * of this is the lobby's own bytecode, unchanged, including the yes/no in front
+ * of it and the branch on the code that comes back.
+ *
+ * The party slot the player already registered is in VAR_MAP_LOCAL_0x02: the
+ * lobby's script picks the Pokemon BEFORE it forms the group
+ * (Contests_OfficialContestRegisterMon runs before Contests_OfficialContestStart),
+ * so by the time either command runs there is a monster chosen.
+ * mmo/mods/openmmo/src/openmmo_contest_link.c. */
+static BOOL openmmo_contest_club_poll(ScriptContext *ctx)
+{
+    extern int openmmo_contest_club_result(void);
+
+    FieldSystem *fieldSystem = ctx->fieldSystem;
+    u16 *destVar = FieldSystem_GetVarPointer(fieldSystem, ctx->data[0]);
+    int code = openmmo_contest_club_result();
+
+    if (code == COMM_CLUB_RET_0) {
+        return FALSE;
+    }
+
+    *destVar = code;
+    return TRUE;
+}
+
+/* 1 when this client took the door, so the official comm club stays out of it. */
+static BOOL openmmo_contest_club_take(ScriptContext *ctx, int commType,
+    int contestType, int contestRank, u16 destVarID)
+{
+    extern int openmmo_contest_club_start(int commType, int contestType,
+        int contestRank, int partySlot);
+
+    u16 *slotVar = FieldSystem_GetVarPointer(ctx->fieldSystem, VAR_MAP_LOCAL_0x02);
+    int slot = slotVar != NULL ? (int)*slotVar : 0;
+
+    if (!openmmo_contest_club_start(commType, contestType, contestRank, slot)) {
+        return FALSE;
+    }
+
+    ctx->data[0] = destVarID;
+    ScriptContext_Pause(ctx, openmmo_contest_club_poll);
+    return TRUE;
+}
+
 static BOOL ScrCmd_StartBattleClient(ScriptContext *ctx)
