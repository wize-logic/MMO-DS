+/* Which flag says a trainer has been beaten.
+ *
+ * The block this game ships is 928 flags for its own 928 trainers and the next
+ * one along is in use, so a PORTED trainer, numbered from 928 up, cannot
+ * have `TRAINER_DEFEATED_FLAGS_START + trainerID`: that walks out of the block
+ * and sets a flag of this game's story. Ported numbers go to a block of their
+ * own at the top of the array instead (include/vars_flags.h). Flag 0 is the
+ * one VarsFlags_GetFlagChunk answers NULL for, so a number past even that
+ * reads false and writes nothing rather than landing somewhere.
+ *
+ * The two ranges never meet: a trainer is 0..927 or it is ported. */
+static u16 openmmo_trainer_defeated_flag(u16 trainerID)
+{
+    u16 shipped = TRAINER_DEFEATED_FLAGS_END - TRAINER_DEFEATED_FLAGS_START;
+
+    if (trainerID <= shipped) {
+        return TRAINER_DEFEATED_FLAGS_START + trainerID;
+    }
+    if (trainerID - (shipped + 1) < OPENMMO_PORTED_TRAINERS_MAX) {
+        return PORTED_TRAINER_DEFEATED_FLAGS_START + (trainerID - (shipped + 1));
+    }
+    return 0;
+}
