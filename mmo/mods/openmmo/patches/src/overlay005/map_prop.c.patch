 void MapPropManager_Free(MapPropManager *mapPropManager)
 {
+    /* openmmo: the props' render objects die here with their chunk; the
+     * animation clones sitting in them are given back first
+     * (map_prop_animation.c), or the slot keeps a dead link and hands it
+     * to the next chunk that places the model. */
+    for (u8 i = 0; i < MAX_LOADED_MAP_PROPS; i++) {
+        if (mapPropManager->loadedProps[i].loaded) {
+            MapPropAnimationManager_ReleaseRenderObj(&mapPropManager->loadedProps[i].renderObj);
+        }
+    }
     Heap_Free(mapPropManager);
     mapPropManager = NULL;
 }
