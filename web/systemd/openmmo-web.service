[Unit]
Description=OpenMMO website (registration and status)
Documentation=https://github.com/wize-logic/OpenMMO
After=network-online.target docker.service openmmo-db.service
Wants=network-online.target
# One of the four services openmmo.target starts and stops together. PartOf= is what
# makes `systemctl stop openmmo.target` reach this one.
PartOf=openmmo.target

[Service]
Type=exec
User=openmmo-web
Group=openmmo-web
# Database credentials and ports. Written by web/deploy.sh, root readable only.
EnvironmentFile=/etc/openmmo/web.env
ExecStart=/opt/openmmo/web/bin/server.web
# The JVM leaves on SIGTERM with 128+15, which systemd would otherwise record as a
# failure, so a plain stop left the unit failed and nothing brought it back. Say that
# exit is clean, and restart on every other way of dying.
SuccessExitStatus=143
Restart=always
RestartSec=5s

# It listens on loopback, reads one directory and talks to postgres. Nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target openmmo.target
